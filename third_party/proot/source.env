# Pinned inputs for third_party/proot/build.sh (sourced by the script).
# proot: Termux's fork, the commit Termux's 5.1.107-70 package is built from.
PROOT_COMMIT=4dba3afbf3a63af89b4d9c1a59bf2bda10f4d10f
PROOT_SHA256=de94f648547d1b62431073b82dc99d56ef0ddcef6da022e0dfffe2bf661cc34e
# Patch set: DroidDeck's tools/proot/ (patches, headers) at a pinned commit.
# Only the GPL-2 proot patches and small headers are taken, at build time.
DD_COMMIT=6fe7b4ec1109169c71c10b77c648eb649ee97423
# sha256 of the codeload tarball; empty = not recorded yet, the commit id of the
# git fetch fallback is the integrity check instead (see build.sh).
DD_SHA256=
# talloc (LGPL-3), linked statically.
TALLOC_VERSION=2.4.3
TALLOC_SHA256=dc46c40b9f46bb34dd97fe41f548b0e8b247b77a918576733c528e83abd854dd
# Fallback when samba.org is unreachable: the release tag in Samba's git tree.
TALLOC_GIT_COMMIT=77229f73c20af69ab0f3c96efbb229ff64a9dfe4
