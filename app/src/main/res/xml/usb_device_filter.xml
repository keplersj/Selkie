<?xml version="1.0" encoding="utf-8"?>
<!--
  USB devices Android offers to open Selkie for (UsbBridge): the adb interface and the fastboot interface
  (vendor-specific class 0xff, subclass 0x42, protocol 1 and 3). Android matches a device's interfaces as
  well as the device itself, and its prompt lets the person always open Selkie for that device, so a flash
  that reboots the target into its bootloader doesn't stop at each step.
-->
<resources>
    <usb-device class="255" subclass="66" protocol="1" />
    <usb-device class="255" subclass="66" protocol="3" />
</resources>
